{
    "manifest_version": 3,
    "name": "QuickFlows",
    "description": "Launch workflows instantly with customizable keyboard shortcuts.",
    "version": "1.0.0",
    "icons": {
        "16": "assets/icons/icon16.png",
        "32": "assets/icons/icon32.png",
        "48": "assets/icons/icon48.png",
        "128": "assets/icons/icon128.png",
        "256": "assets/icons/icon256.png",
        "512": "assets/icons/icon512.png"
    },
    "action": {
        "default_title": "QuickFlows",
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "assets/icons/icon16.png",
            "32": "assets/icons/icon32.png",
            "48": "assets/icons/icon48.png",
            "128": "assets/icons/icon128.png"
        }
    },
    "permissions": [
        "activeTab",
        "scripting",
        "tabs",
        "storage",
        "notifications"
    ],
    "options_page": "app/dashboard.html",
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "commands": {
        "activate": {
            "suggested_key": {
                "default": "Ctrl+Shift+0"
            },
            "description": "key listener"
        },
        "default_1": {
            "suggested_key": {
                "default": "Ctrl+Shift+1"
            },
            "description": "default keybind 1"
        },
        "default_2": {
            "suggested_key": {
                "default": "Ctrl+Shift+2"
            },
            "description": "default keybind 2"
        },
        "default_3": {
            "suggested_key": {
                "default": "Ctrl+Shift+3"
            },
            "description": "default keybind 3"
        }
    }
}